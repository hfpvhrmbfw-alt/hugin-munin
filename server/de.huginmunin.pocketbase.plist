<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Startet PocketBase beim Hochfahren des Mac mini, auch ohne Anmeldung.
     BENUTZERNAME an zwei Stellen ersetzen, dann nach /Library/LaunchDaemons/ kopieren (siehe docs/MAC-MINI.md). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>de.huginmunin.pocketbase</string>
  <key>UserName</key><string>BENUTZERNAME</string>
  <key>WorkingDirectory</key><string>/Users/BENUTZERNAME/hugin-munin-server</string>
  <key>ProgramArguments</key>
  <array>
    <string>./pocketbase</string>
    <string>serve</string>
    <string>--http=127.0.0.1:8090</string>
    <string>--dir=pb_data</string>
    <string>--publicDir=pb_public</string>
    <string>--migrationsDir=pb_migrations</string>
    <string>--hooksDir=pb_hooks</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/hugin-munin-pocketbase.log</string>
  <key>StandardErrorPath</key><string>/tmp/hugin-munin-pocketbase.log</string>
</dict>
</plist>
